# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Secrets live in the macOS Keychain, never on disk. These entries are a
# backstop so a stray file can never be committed.
.env
.env.*
!.env.example

# Encrypted personal data. Never committed.
data/

# Local deploy overrides (public hostname, port). No secrets - those live in the Keychain.
deploy/deploy.env
