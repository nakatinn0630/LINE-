{
  "permissions": {
    "deny": [
      "Read(./data/**)",
      "Edit(./data/**)",
      "Write(./data/**)",
      "Bash(cat ./data/**)",
      "Bash(strings ./data/**)",
      "Bash(sqlite3 ./data/**)",
      "Bash(cp ./data/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/block_data_access.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the command against data/ access rules"
          }
        ]
      }
    ]
  }
}
